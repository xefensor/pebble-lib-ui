{
  "name": "pebble-xoce-ui",
  "version": "0.1.1",
  "author": "Xef",
  "description": "Small shared drawing helpers and phone settings styles for XOCE Pebble apps.",
  "main": "src/js/settings-style.js",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist.zip",
    "settings-style.js",
    "pebble-xoce-ui.h",
    "metrics.h",
    "src",
    "include",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "python3 scripts/test-native.py && node --check src/js/settings-style.js && npm run test:release && npm run test:workflow && npm run check:docs",
    "build": "python3 scripts/build.py",
    "pack:candidate": "python3 scripts/package-candidate.py",
    "release:prepare": "python3 scripts/github-release.py prepare",
    "release:publish": "python3 scripts/github-release.py publish",
    "test:release": "python3 -m unittest discover -s tests -p \"test_*release*.py\"",
    "test:workflow": "python3 -m unittest discover -s tests -p test_development_workflow.py",
    "check:docs": "python3 scripts/check-docs.py",
    "release:package": "python3 scripts/package-release.py",
    "test:native": "python3 scripts/test-native.py",
    "test:source": "python3 scripts/test-native.py && node --check src/js/settings-style.js"
  },
  "pebble": {
    "projectType": "package",
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "resources": {
      "media": []
    }
  }
}
